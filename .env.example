# REQUIRED: Groq API Key for AI-powered analysis
# Get your free API key from: https://console.groq.com/keys
# Format: gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=your_groq_api_key_here


